{
  "rules": {
    ".read": false,
    ".write": false,
    "data": {
      ".read": "auth != null && auth.uid === '3iEIfsbZlaUMwUiGY6Lro4jAQef1'",
      ".write": "auth != null && auth.uid === '3iEIfsbZlaUMwUiGY6Lro4jAQef1'"
    },
    "data_build": {
      ".read": "auth != null && auth.uid === '3iEIfsbZlaUMwUiGY6Lro4jAQef1'",
      ".write": "auth != null && auth.uid === '3iEIfsbZlaUMwUiGY6Lro4jAQef1'"
    },
    "platform": {
      "admins": { "$uid": { ".read": "auth != null && auth.uid === $uid" } }
    },
    "apps": {
      "$app": {
        "users": {
          "$uid": {
            ".read": "auth != null && (auth.uid === $uid || (root.child('apps').child($app).child('consents').child($uid).child(auth.uid).val() === true && root.child('apps').child($app).child('consents').child(auth.uid).child($uid).val() === true))",
            ".write": "auth != null && (auth.uid === $uid || (root.child('apps').child($app).child('consents').child($uid).child(auth.uid).val() === true && root.child('apps').child($app).child('consents').child(auth.uid).child($uid).val() === true))"
          }
        },
        "consents": {
          "$uid": {
            "$other": {
              ".read": "auth != null && (auth.uid === $uid || auth.uid === $other)",
              ".write": "auth != null && auth.uid === $uid",
              ".validate": "newData.isBoolean()"
            }
          }
        },
        "households": {
          "$hid": { ".read": "auth != null && data.child('members').child(auth.uid).val() === true" }
        },
        "entitlements": { "$uid": { ".read": "auth != null && auth.uid === $uid" } },
        "energy": { "$uid": { ".read": "auth != null && auth.uid === $uid" } },
        "ledger": { "$uid": { ".read": "auth != null && auth.uid === $uid" } },
        "usage": { "$uid": { ".read": "auth != null && auth.uid === $uid" } },
        "config": {
          ".read": "auth != null",
          ".write": "auth != null && root.child('platform').child('admins').child(auth.uid).val() === true"
        },
        "admin": {
          ".read": "auth != null && root.child('platform').child('admins').child(auth.uid).val() === true"
        },
        "tracker": {
          ".read": "auth != null && root.child('platform').child('admins').child(auth.uid).val() === true",
          "$id": {
            ".write": "auth != null && (root.child('platform').child('admins').child(auth.uid).val() === true || (!data.exists() && newData.child('uid').val() === auth.uid))"
          }
        }
      }
    }
  }
}
